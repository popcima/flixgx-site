PORT=8788
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8788
# Optional: enables your own authenticated calls to the full /v1 API.
# Browser playback uses /api/playback and never receives this secret.
API_KEY=
# Optional, only for backend /v1/search and /v1/tmdb endpoints.
# The existing catalog still uses its existing TMDB configuration.
TMDB_READ_TOKEN=
# If the frontend and API are hosted separately, list exact website origins.
CORS_ORIGINS=https://flixgx.com,https://www.flixgx.com
# Add a provider CDN only after verifying it; comma-separated host names.
EXTRA_MEDIA_HOSTS=
